# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
#
# Every variable exposed to the browser MUST be prefixed NEXT_PUBLIC_.
# Anything without that prefix is server-only (safe for secrets, but this
# frontend currently has no server-only env vars since all data is either
# mocked or fetched client-side from the public Express API).

# Base URL of the Express backend API. Leave blank while NEXT_PUBLIC_USE_MOCK_API=true.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Set to "false" once the backend endpoints in docs/API_INTEGRATION.md exist
# and you're ready to switch off mock data.
NEXT_PUBLIC_USE_MOCK_API=true

# Server-only Grok API key. Copy your production key into .env.local only.
GROK_API_KEY=your_grok_api_key_here

# Used for canonical URLs / metadata in production builds.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
