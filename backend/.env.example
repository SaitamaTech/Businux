# Backend environment variables
# Copy to .env and fill in real values

PORT=4000
NODE_ENV=development

# Frontend URL for CORS (set this on Render to your Vercel domain)
FRONTEND_URL=http://localhost:3000

# Gemini API Key (server-side only) - from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database or other external services can be configured here
# DATABASE_URL=
# REDIS_URL=
